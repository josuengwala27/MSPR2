# Dockerfile spécial France - API IA avec connexion directe PostgreSQL
FROM python:3.11-slim

WORKDIR /app

# Installation des dépendances système pour PostgreSQL
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copie des fichiers de dépendances
COPY requirements-france.txt .
RUN pip install --no-cache-dir -r requirements-france.txt

# Copie du code source
COPY . .

# Création des dossiers de logs
RUN mkdir -p logs

# Port d'exposition
EXPOSE 8000

# Commande de démarrage avec mode France
CMD ["uvicorn", "main_france:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]